# Sys

# Pulse Audio volume controls
bindsym --inhibited XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --inhibited XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --inhibited XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle # mute

# Sreen brightness controls
# NOTE...  this is not xrandr's xbacklight.  Instead it manipulates /sys/class/* directly
bindsym --inhibited XF86MonBrightnessUp exec xbacklight -inc 5 # increase brightness
bindsym --inhibited XF86MonBrightnessDown exec xbacklight -dec 5 # decrease brightness
bindsym --inhibited Shift+XF86MonBrightnessUp exec xbacklight -inc 10 # increase brightness slightly
bindsym --inhibited Shift+XF86MonBrightnessDown exec xbacklight -dec 10 # decrease brightness slightly

